# PostgreSQL database URL. Use the psycopg2 driver installed by this project.
DATABASE_URL=postgresql+psycopg2://routeai:routeai_secret@localhost:5432/routeai_db

# Required application security settings. Replace the example key before deployment.
SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
